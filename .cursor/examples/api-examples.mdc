# API Examples

## Basic API Functions
```typescript
// shared/api/pokeapi.ts
import axios from 'axios';

const API_BASE_URL = 'https://pokeapi.co/api/v2';

export const getPokemonList = async (
  offset: number = 0,
  limit: number = 20
): Promise<PokemonListResponse> => {
  try {
    const response = await axios.get<PokemonListResponse>(
      `${API_BASE_URL}/pokemon?offset=${offset}&limit=${limit}`
    );
    return response.data;
  } catch (error) {
    throw new Error(`Failed to fetch Pokemon list: ${error}`);
  }
};

export const getPokemonDetails = async (
  nameOrId: string | number
): Promise<Pokemon> => {
  try {
    const response = await axios.get<Pokemon>(
      `${API_BASE_URL}/pokemon/${nameOrId}`
    );
    return response.data;
  } catch (error) {
    throw new Error(`Failed to fetch Pokemon details: ${error}`);
  }
};
```

## Cached API Functions
```typescript
// shared/api/pokemonCache.ts
import { storage } from '@/shared/utils/storage';

interface CachedPokemon {
  data: Pokemon;
  timestamp: number;
  ttl: number;
}

export class PokemonCache {
  private static readonly TTL = 5 * 60 * 1000; // 5 minutes
  private static readonly PREFIX = 'pokemon_';

  static set(id: string, pokemon: Pokemon): void {
    const cached: CachedPokemon = {
      data: pokemon,
      timestamp: Date.now(),
      ttl: this.TTL
    };
    storage.set(`${this.PREFIX}${id}`, cached);
  }

  static get(id: string): Pokemon | null {
    const cached = storage.get<CachedPokemon>(`${this.PREFIX}${id}`, null);
    
    if (!cached) return null;
    
    if (Date.now() - cached.timestamp > cached.ttl) {
      this.remove(id);
      return null;
    }
    
    return cached.data;
  }

  static remove(id: string): void {
    storage.remove(`${this.PREFIX}${id}`);
  }
}

export const getCachedPokemonDetails = async (
  nameOrId: string | number
): Promise<Pokemon> => {
  const cacheKey = `${nameOrId}`;
  const cached = PokemonCache.get(cacheKey);
  
  if (cached) {
    return cached;
  }
  
  const pokemon = await getPokemonDetails(nameOrId);
  PokemonCache.set(cacheKey, pokemon);
  return pokemon;
};
```

