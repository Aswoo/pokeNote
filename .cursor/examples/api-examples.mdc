    const pokemonDetails = await Promise.all(
      paginatedPokemon.map((pokemon: any) =>
        getPokemonDetails(pokemon.pokemon.name)
      )
    );
    
    return {
      count: pokemonList.length,
      next: offset + limit < pokemonList.length ? 'true' : null,
      previous: offset > 0 ? 'true' : null,
      results: pokemonDetails.map((pokemon) => ({
        name: pokemon.name,
        url: `${API_BASE_URL}/pokemon/${pokemon.id}/`,
      })),
    };
  } catch (error) {
    throw new Error(`Failed to fetch Pokemon by type: ${error}`);
  }
