## API Optimization
```typescript
// Good: Parallel API calls
export const getPokemonWithDetails = async (pokemonList: PokemonListItem[]) => {
  const promises = pokemonList.map(pokemon => 
    getPokemonDetails(pokemon.name)
  );
  
  return Promise.all(promises);
};

// Good: Caching API responses
const pokemonCache = new Map<string, Pokemon>();

export const getCachedPokemon = async (id: string): Promise<Pokemon> => {
  if (pokemonCache.has(id)) {
    return pokemonCache.get(id)!;
  }
  
  const pokemon = await getPokemonDetails(id);
  pokemonCache.set(id, pokemon);
  return pokemon;
};
```

## Virtual Scrolling
```typescript
// Good: Virtual scrolling for large lists
import { FixedSizeList as List } from 'react-window';

export const VirtualizedPokemonList = ({ pokemonList }: { pokemonList: Pokemon[] }) => {
  const Row = ({ index, style }: { index: number; style: React.CSSProperties }) => (
    <div style={style}>
      <PokemonCard pokemon={pokemonList[index]} />
    </div>
  );

  return (
    <List
      height={600}
      itemCount={pokemonList.length}
      itemSize={200}
      width="100%"
    >
      {Row}
    </List>
  );
};
```

## Debouncing
```typescript
// Good: Debounced search
import { useDebounce } from '@/shared/hooks/useDebounce';

export const SearchBar = ({ onSearch }: { onSearch: (query: string) => void }) => {
  const [query, setQuery] = useState('');
  const debouncedQuery = useDebounce(query, 300);

  useEffect(() => {
    onSearch(debouncedQuery);
  }, [debouncedQuery, onSearch]);

  return (
    <input
      type="text"
      value={query}
      onChange={(e) => setQuery(e.target.value)}
      placeholder="Search Pokemon..."
    />
  );
};
```

## Memory Management
```typescript
// Good: Cleanup effects
export const usePokemonData = (id: string) => {
  const [pokemon, setPokemon] = useState<Pokemon | null>(null);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    let cancelled = false;

    const fetchPokemon = async () => {
      try {
        setLoading(true);
        const data = await getPokemonDetails(id);
        
        if (!cancelled) {
          setPokemon(data);
        }
      } catch (error) {
        if (!cancelled) {
          console.error('Failed to fetch Pokemon:', error);
        }
      } finally {
        if (!cancelled) {
          setLoading(false);
        }
      }
    };

    fetchPokemon();

    return () => {
      cancelled = true;
    };
  }, [id]);

  return { pokemon, loading };
};
```

## Avoid
- Don't create functions in render without useCallback
- Don't create objects in render without useMemo
- Don't ignore bundle size
- Don't forget to cleanup effects
- Don't use large images without optimization