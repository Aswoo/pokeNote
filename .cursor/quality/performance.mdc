# Performance Optimization Rules

## React Performance
- Use `React.memo` for expensive components
- Use `useCallback` for event handlers
- Use `useMemo` for expensive calculations
- Optimize images with `next/image`
- Implement code splitting with dynamic imports

## Memoization
```typescript
// Good: Memoized component
export const PokemonCard = React.memo(({ pokemon, onSelect }: PokemonCardProps) => {
  const handleClick = useCallback(() => {
    onSelect?.(pokemon);
  }, [pokemon, onSelect]);

  return (
    <div onClick={handleClick}>
      {/* Component content */}
    </div>
  );
});

// Good: Memoized expensive calculation
export const PokemonList = ({ pokemonList }: { pokemonList: Pokemon[] }) => {
  const sortedPokemon = useMemo(() => {
    return pokemonList.sort((a, b) => a.name.localeCompare(b.name));
  }, [pokemonList]);

  return (
    <div>
      {sortedPokemon.map(pokemon => (
        <PokemonCard key={pokemon.id} pokemon={pokemon} />
      ))}
    </div>
  );
};
```

## Image Optimization
```typescript
// Good: Using next/image for optimization
import Image from 'next/image';

export const PokemonCard = ({ pokemon }: { pokemon: Pokemon }) => {
  return (
    <div>
      <Image
        src={pokemon.sprites.front_default}
        alt={pokemon.name}
        width={200}
        height={200}
        priority={false}
        placeholder="blur"
        blurDataURL="data:image/jpeg;base64,"
      />
    </div>
  );
};
```

## Code Splitting
```typescript
// Good: Dynamic imports for code splitting
import { lazy, Suspense } from 'react';

const Pokemon3DViewer = lazy(() => import('./Pokemon3DViewer'));
const QuizGame = lazy(() => import('./QuizGame'));

export const PokemonDetailPage = ({ pokemon }: { pokemon: Pokemon }) => {
  return (
    <div>
      <Suspense fallback={<div>Loading 3D viewer...</div>}>
        <Pokemon3DViewer pokemon={pokemon} />
      </Suspense>
    </div>
  );
};
```

