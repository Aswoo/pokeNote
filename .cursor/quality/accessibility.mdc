## Form Accessibility
```typescript
// Good: Accessible form
export const PokemonForm = ({ onSubmit }: { onSubmit: (data: FormData) => void }) => {
  const [errors, setErrors] = useState<Record<string, string>>({});

  return (
    <form onSubmit={handleSubmit} noValidate>
      <div className="form-group">
        <label htmlFor="pokemon-name" className="required">
          포켓몬 이름
        </label>
        <input
          id="pokemon-name"
          type="text"
          required
          aria-describedby="name-error"
          aria-invalid={!!errors.name}
        />
        {errors.name && (
          <div id="name-error" role="alert" className="error-message">
            {errors.name}
          </div>
        )}
      </div>
      
      <button type="submit" className="submit-button">
        제출
      </button>
    </form>
  );
};
```

## Avoid
- Don't use div for interactive elements
- Don't forget to provide alt text for images
- Don't ignore keyboard navigation
- Don't use low contrast colors
- Don't forget to test with screen readers