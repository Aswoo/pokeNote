# 3D Components Rules

## Three.js Integration
- Use Three.js for 3D Pokemon cards
- Implement proper cleanup for Three.js resources
- Use React Three Fiber for React integration
- Handle 3D component mounting/unmounting

## React Three Fiber Setup
```typescript
// components/3D/Pokemon3DViewer.tsx
'use client';

import { Canvas } from '@react-three/fiber';
import { OrbitControls, Environment, ContactShadows } from '@react-three/drei';
import { Suspense } from 'react';

interface Pokemon3DViewerProps {
  pokemon: Pokemon;
}

export const Pokemon3DViewer = ({ pokemon }: Pokemon3DViewerProps) => {
  return (
    <div className="w-full h-96 bg-gray-100 dark:bg-gray-800 rounded-lg">
      <Canvas
        camera={{ position: [0, 0, 5], fov: 50 }}
        shadows
        gl={{ antialias: true }}
      >
        <Suspense fallback={null}>
          <PokemonModel pokemon={pokemon} />
          <Environment preset="studio" />
          <ContactShadows 
            position={[0, -1.4, 0]} 
            opacity={0.75} 
            scale={10} 
            blur={2.5} 
            far={4.5} 
          />
          <OrbitControls 
            enablePan={false} 
            enableZoom={true} 
            enableRotate={true}
            minPolarAngle={Math.PI / 6}
            maxPolarAngle={Math.PI - Math.PI / 6}
          />
        </Suspense>
      </Canvas>
    </div>
  );
};
```

## 3D Model Component
```typescript
// components/3D/PokemonModel.tsx
import { useRef, useEffect } from 'react';
import { useFrame, useLoader } from '@react-three/fiber';
import { GLTFLoader } from 'three/examples/jsm/loaders/GLTFLoader';
import { Mesh, Group } from 'three';

interface PokemonModelProps {
  pokemon: Pokemon;
}

export const PokemonModel = ({ pokemon }: PokemonModelProps) => {
  const meshRef = useRef<Group>(null);
  const gltf = useLoader(GLTFLoader, `/models/${pokemon.name}.glb`);
  
  useFrame((state) => {
    if (meshRef.current) {
      meshRef.current.rotation.y = Math.sin(state.clock.elapsedTime) * 0.1;
    }
  });

  return (
    <group ref={meshRef}>
      <primitive object={gltf.scene} scale={[2, 2, 2]} />
    </group>
  );
};
```

## 3D Card Component
```typescript
// components/3D/Pokemon3DCard.tsx
import { useState, useRef } from 'react';
import { Canvas } from '@react-three/fiber';
import { OrbitControls } from '@react-three/drei';

interface Pokemon3DCardProps {
  pokemon: Pokemon;
  onSelect?: (pokemon: Pokemon) => void;
}

export const Pokemon3DCard = ({ pokemon, onSelect }: Pokemon3DCardProps) => {
  const [isHovered, setIsHovered] = useState(false);
  const cardRef = useRef<HTMLDivElement>(null);

  return (
    <div
      ref={cardRef}
      className={`
        relative w-64 h-80 rounded-lg overflow-hidden
        bg-white dark:bg-gray-800
        shadow-lg hover:shadow-xl
        transition-all duration-300
        cursor-pointer
        ${isHovered ? 'scale-105' : 'scale-100'}
      `}
      onMouseEnter={() => setIsHovered(true)}
      onMouseLeave={() => setIsHovered(false)}
      onClick={() => onSelect?.(pokemon)}
    >
      <Canvas
        camera={{ position: [0, 0, 5], fov: 50 }}
        gl={{ antialias: true }}
      >
        <Suspense fallback={null}>
          <PokemonModel pokemon={pokemon} />
          <OrbitControls 
            enablePan={false} 
            enableZoom={false} 
            enableRotate={isHovered}
            autoRotate={!isHovered}
            autoRotateSpeed={2}
          />
        </Suspense>
      </Canvas>
      
      <div className="absolute bottom-0 left-0 right-0 p-4 bg-gradient-to-t from-black/80 to-transparent">
        <h3 className="text-white font-bold text-lg capitalize">
          {pokemon.name}
        </h3>
        <div className="flex gap-2 mt-2">
          {pokemon.types.map((type) => (
            <span
              key={type.type.name}
              className="px-2 py-1 rounded-full text-xs font-medium"
              style={{
                backgroundColor: `var(--type-${type.type.name})`,
                color: 'white'
              }}
            >
              {type.type.name}
            </span>
          ))}
        </div>
      </div>
    </div>
  );
};
```

## Performance Optimization
```typescript
// Good: Memoized 3D components
export const Pokemon3DViewer = React.memo(({ pokemon }: Pokemon3DViewerProps) => {
  // Component implementation
});

// Good: Lazy loading for 3D models
const Pokemon3DCard = lazy(() => import('./Pokemon3DCard'));

// Good: Error boundary for 3D components
export const Pokemon3DErrorBoundary = ({ children }: { children: ReactNode }) => {
  return (
    <ErrorBoundary
      fallback={
        <div className="w-full h-96 bg-gray-100 dark:bg-gray-800 rounded-lg flex items-center justify-center">
          <p className="text-gray-500">Failed to load 3D model</p>
        </div>
      }
    >
      {children}
    </ErrorBoundary>
  );
};
```

