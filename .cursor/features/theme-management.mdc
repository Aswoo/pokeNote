## Theme Usage
```typescript
// Good: Using theme in components
export const PokemonCard = ({ pokemon }: { pokemon: Pokemon }) => {
  const { theme } = useTheme();
  const type = pokemon.types[0].type.name;
  
  return (
    <div 
      className={`
        bg-white dark:bg-gray-800 
        text-gray-900 dark:text-white
        border border-gray-200 dark:border-gray-700
        hover:border-${type}
        hover:shadow-${type}
      `}
      style={{
        '--type-color': `var(--type-${type})`,
        borderColor: `var(--type-${type})`,
        boxShadow: `0 0 20px var(--type-${type})`
      }}
    >
      {/* Card content */}
    </div>
  );
};
```

## Theme Toggle Component
```typescript
// components/ThemeToggle.tsx
export const ThemeToggle = () => {
  const { theme, toggleTheme } = useTheme();
  
  return (
    <button
      onClick={toggleTheme}
      className="
        p-2 rounded-lg
        bg-gray-100 dark:bg-gray-800
        text-gray-900 dark:text-white
        hover:bg-gray-200 dark:hover:bg-gray-700
        transition-colors duration-200
      "
      aria-label={`Switch to ${theme === 'light' ? 'dark' : 'light'} mode`}
    >
      {theme === 'light' ? (
        <MoonIcon className="w-5 h-5" />
      ) : (
        <SunIcon className="w-5 h-5" />
      )}
    </button>
  );
};
```

## SSR Handling
```typescript
// Good: SSR-safe theme handling
export const useTheme = () => {
  const [mounted, setMounted] = useState(false);
  const context = useContext(ThemeContext);
  
  useEffect(() => {
    setMounted(true);
  }, []);
  
  if (!mounted) {
    return { theme: 'light', toggleTheme: () => {} };
  }
  
  if (context === undefined) {
    throw new Error('useTheme must be used within a ThemeProvider');
  }
  
  return context;
};
```

## Avoid
- Don't forget to handle SSR for theme
- Don't use hardcoded colors when CSS variables work
- Don't ignore system preference
- Don't forget to update CSS variables for dark theme